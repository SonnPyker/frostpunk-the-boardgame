# Root .env.example: documents every variable used by the project.
# Copy the relevant part into apps/server/.env (local server) and apps/web/.env.local (local web).
# Never commit real values. Never put SUPABASE_SERVICE_ROLE_KEY in any VITE_* variable.

# ---- Server (apps/server, Render) -------------------------------------------
PORT=8080
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
PERSIST_SNAPSHOT_EVERY=10
# Capacity and housekeeping (defaults shown; see apps/server/.env.example and docs/DEPLOYMENT.md 2.1).
MAX_ROOMS=200
MAX_CONNECTIONS=1000
MAX_CONN_PER_IP=20
TRUST_PROXY=0
ABANDON_GAME_MINUTES=1440
PERSIST_ATTEMPTS=10
SHUTDOWN_GRACE_MS=20000

# ---- Web (apps/web, Vercel build-time, read by Vite) ------------------------
VITE_SERVER_URL=ws://localhost:8080
# The browser never talks to Supabase directly: only the server holds the Supabase credentials.
