# Dependencies
node_modules/

# Build output (regenerated by `npm run build:web` / `npm run build:server`)
dist/
build/
apps/web/dist/
apps/server/dist/
*.tsbuildinfo

# Tests and coverage
coverage/

# Local scratch: debugging images, sim output, notes. Not part of the project.
scratch/

# Environment files: real secrets live here. The *.example files are committed.
.env
.env.*
!.env.example
!apps/web/.env.example
!apps/server/.env.example

# Raw source asset copy (about 175 MB of TTS mod files: audio, images, PDF, OBJ models).
# Deployed assets are the optimised set under apps/web/public/assets, which IS committed.
# Keep the raw copy local. See README.md "Assets".
assets_src/

# Tooling caches
.vite/
.vercel/
.render/
.cache/
__pycache__/
*.pyc
.pytest_cache/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Editors and OS
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# Generated by tools/i18n/harvest.ts and normalize.mjs (large, reproducible)
tools/i18n/strings.json
tools/i18n/templates.json

# Assets
assets_src/*
*.mp3
*.pdf