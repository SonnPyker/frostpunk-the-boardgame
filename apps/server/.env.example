# Game server (Node + ws). Copy to apps/server/.env for local dev.
# Render: set these in the service Environment tab (render.yaml marks secrets as sync: false).

# HTTP and WebSocket port. Render injects PORT automatically in production.
PORT=8080

# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# Supabase project URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET. Service role key (Supabase > Project Settings > API). Bypasses RLS. Server only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Write a full game snapshot to Supabase every N applied commands (default 10).
PERSIST_SNAPSHOT_EVERY=10

# Capacity and housekeeping. Defaults shown.
# Rooms held in memory; creating beyond this is refused.
MAX_ROOMS=200
# Open WebSocket connections; extra connections get HTTP 503.
MAX_CONNECTIONS=1000
# A live game with no player connected for this many minutes is saved as 'abandoned' and unloaded.
ABANDON_GAME_MINUTES=1440
# Tries per database write (exponential backoff). After the last try the write is dropped and logged.
PERSIST_ATTEMPTS=10
# Open WebSockets per client address; extra ones are closed with 1008.
MAX_CONN_PER_IP=20
# 1 when the server sits behind a reverse proxy (Render): the client address is read from X-Forwarded-For.
# 0 (default) ignores that header. Behind no proxy, leave it at 0.
TRUST_PROXY=0
# On SIGTERM, how long pending database writes may take to finish before exit (1000..120000 ms, default 20000).
SHUTDOWN_GRACE_MS=20000
