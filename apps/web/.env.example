# Web client (Vite). Copy to apps/web/.env.local for local dev.
# VITE_* values are embedded in the public JavaScript bundle at build time.
# They must be public values only. Set the same keys in Vercel > Project > Settings > Environment Variables.

# WebSocket URL of the game server. Local: ws://localhost:8080. Production: wss://<your-render-service>.onrender.com
VITE_SERVER_URL=ws://localhost:8080

# The browser never talks to Supabase directly: only the server (apps/server) holds the Supabase credentials.
